---
import ViewToggle from './ViewToggle.astro';
---

<section class="pane preview-pane" aria-label="Live preview">
  <div class="preview-meta">
    <div class="preview-title-group">
      <span>Live preview</span>
      <span id="preview-stats" class="muted">0 words</span>
    </div>
    <!-- Live Preview View Mode Toggle (Normal View vs Page Break View) -->
    <ViewToggle />
  </div>

  <div class="preview-stage" id="preview-stage">
    <!-- Normal View: Continuous sheet -->
    <article id="html-preview" class="markdown-body page-sheet"></article>

    <!-- Page Break View: Real-time automated page break cards -->
    <div id="pagebreak-preview" class="pagebreak-container" style="display: none;"></div>
  </div>
</section>

<style>
  .preview-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pagebreak-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
</style>
