---
---
<div id="md-toolbar" class="md-toolbar" role="toolbar" aria-label="Markdown formatting">
  <div class="md-group">
    <button type="button" class="md-btn" data-md="bold" title="Bold (Ctrl+B)">
      <span class="material-symbols-outlined icon-md">format_bold</span>
    </button>
    <button type="button" class="md-btn" data-md="italic" title="Italic (Ctrl+I)">
      <span class="material-symbols-outlined icon-md">format_italic</span>
    </button>
    <button type="button" class="md-btn" data-md="strike" title="Strikethrough">
      <span class="material-symbols-outlined icon-md">strikethrough_s</span>
    </button>
    <button type="button" class="md-btn" data-md="highlight" title="Highlight">
      <span class="material-symbols-outlined icon-md">ink_highlighter</span>
    </button>
  </div>

  <div class="md-group">
    <button type="button" class="md-btn" data-md="h1" title="Heading 1">H1</button>
    <button type="button" class="md-btn" data-md="h2" title="Heading 2">H2</button>
    <button type="button" class="md-btn" data-md="h3" title="Heading 3">H3</button>
    <button type="button" class="md-btn" data-md="h4" title="Heading 4">H4</button>
  </div>

  <div class="md-group">
    <button type="button" class="md-btn" data-md="link" title="Link (Ctrl+K)">
      <span class="material-symbols-outlined icon-md">link</span>
    </button>
    <button type="button" class="md-btn" data-md="image" title="Image">
      <span class="material-symbols-outlined icon-md">image</span>
    </button>
    <button type="button" class="md-btn" data-md="code" title="Inline code">
      <span class="material-symbols-outlined icon-md">code</span>
    </button>
    <button type="button" class="md-btn" data-md="codeblock" title="Code block">
      <span class="material-symbols-outlined icon-md">terminal</span>
    </button>
  </div>

  <div class="md-group">
    <button type="button" class="md-btn" data-md="quote" title="Blockquote">
      <span class="material-symbols-outlined icon-md">format_quote</span>
    </button>
    <button type="button" class="md-btn" data-md="ul" title="Bullet list">
      <span class="material-symbols-outlined icon-md">format_list_bulleted</span>
    </button>
    <button type="button" class="md-btn" data-md="ol" title="Numbered list">
      <span class="material-symbols-outlined icon-md">format_list_numbered</span>
    </button>
    <button type="button" class="md-btn" data-md="task" title="Task list">
      <span class="material-symbols-outlined icon-md">check_box</span>
    </button>
  </div>

  <div class="md-group">
    <button type="button" class="md-btn" data-md="table" title="Table">
      <span class="material-symbols-outlined icon-md">table_chart</span>
    </button>
    <button type="button" class="md-btn" data-md="hr" title="Horizontal rule">
      <span class="material-symbols-outlined icon-md">horizontal_rule</span>
    </button>
    <button type="button" class="md-btn" data-md="pagebreak" title="Insert Manual Page Break">
      <span class="material-symbols-outlined icon-md">insert_page_break</span>
    </button>
    <button type="button" class="md-btn" data-md="footnote" title="Footnote">
      <span class="material-symbols-outlined icon-md">subscript</span>
    </button>
    <button type="button" class="md-btn" data-md="toc" title="Table of contents">
      <span class="material-symbols-outlined icon-md">toc</span>
    </button>
  </div>
</div>

<style>
  .icon-md {
    font-size: 18px;
    display: inline-block;
    vertical-align: middle;
  }
</style>
