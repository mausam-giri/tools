{
  "name": "web-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && bun run sync",
    "sync": "bun node -e \"const fs=require('fs'); if(fs.existsSync('./dist')) { fs.cpSync('./dist', '.', {recursive:true}); }\"",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "astro": "^5.2.0",
    "dompurify": "^3.2.3",
    "marked": "^15.0.6"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.10.10",
    "typescript": "^5.7.3"
  }
}
